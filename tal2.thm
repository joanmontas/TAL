Specification "tal2". 
Import "tal2User". 

/* Obtained by editing tal1.thm. 
   Comments are inserted only where modifications/additions from tal1 were needed, and are tagged TAL2 
   Below, we refer to asm_jmp_bnz simply as 'asm' for the sake of simplicity */
   

Theorem Lookup-store-weakening-H:
  forall env, forall env', forall l, forall t,
    {subsetEnvH env env'} ->
    {lookupEnvH env l t} ->
    {lookupEnvH env' l t}.
IH0 : induction on 1. intros Main Lookup. Subset: case Main.
 search.
 apply IH0 to Subset Lookup.
 search.

 
/* TAL1: tal has multiple typeOf relations rather than just one typeOf. 
   TypeOfW-weakening-H and typeOfV-weakening-H are asm's TypeOf-weakening-H but for typeOfW and typeOfV, respectively. 
   Differently from asm, Type-state-envs-weakening-H uses typeOfV-weakening-H, which uses typeOfW-weakening-H */

Theorem TypeOfW-weakening-H :
  forall gamma EnvH EnvR e t fl EnvH',
    {typeOfW gamma EnvH EnvR e t fl} ->
    {subsetEnvH EnvH EnvH'} ->
    {typeOfW gamma EnvH' EnvR e t fl}.
intros Main Subset.
  case Main. 
search.
  search.
  apply Lookup-store-weakening-H to Subset H1.
  search.

Theorem TypeOfV-weakening-H :
  forall gamma EnvH EnvR e t EnvH',
    {typeOfV gamma EnvH EnvR e t} ->
    {subsetEnvH EnvH EnvH'} ->
    {typeOfV gamma EnvH' EnvR e t}.
intros Main Subset.
  case Main.
  apply TypeOfW-weakening-H to H1 Subset.
  search.
  

/* TAL1: slight modification to derive typeOfV formulae to satisfy the typeOfV premises of typeOf, these are MaddV, MmultV, etc. below. */

Theorem Type-state-envs-weakening-H:
  forall gamma, forall EnvH, forall EnvR, forall e, forall t, forall EnvH',
    {typeOf gamma EnvH EnvR e t} ->
    {subsetEnvH EnvH EnvH'} ->
    {typeOf gamma EnvH' EnvR e t}.
IH0 : induction on 1. intros Main Subset.
Typing0: case Main(keep). 
search.
MaddV: apply TypeOfV-weakening-H to Typing2 Subset.
Madd: apply IH0 to Typing3 Subset.  
search.  
MmultV: apply TypeOfV-weakening-H to Typing2 Subset.  
Mmult: apply IH0 to Typing3 Subset.  
search.
Mload: apply IH0 to Typing3 Subset.  
search.  
Mmalloc: apply IH0 to Typing1 Subset.  
search.  
MmoveV: apply TypeOfV-weakening-H to Typing1 Subset.
Mmove: apply IH0 to Typing2 Subset.  
search.  
Mstore: apply IH0 to Typing4 Subset.  
search.  
MjmpV: apply TypeOfV-weakening-H to Typing0 Subset.
search.  
MbnzV: apply TypeOfV-weakening-H to Typing1 Subset.  
Mbnz: apply IH0 to Typing2 Subset.  
search.


/* TAL1: slight modification, Irrelevance-Env-for-ValueTyping-R uses typeOfV */
/* TAL2: Irrelevance-Env-for-ValueTyping-R is now two theorems, 1) Irrelevance-Env-for-ValueTyping-R below that works with typeOfV, 2) and Type-state-envs-weakening-R that works with typeOf */
/* TAL2: optimization, Irrelevance-Env-for-ValueTyping-R does not neet the premise {value v} because it works with typeOfV, that premise has been removed */
/* TAL2: slight modification, theorem works for Gamma rather than nilEnvH, same proof works. Type-state-envs-weakening-R needs Gamma. For asm_bnz_jmp and tal1, nilEnvH was fine. */

Theorem Irrelevance-Env-for-ValueTyping-R: 
  forall EnvH, forall Gamma EnvR, forall v, forall t, forall EnvR',
  {typeOfV Gamma EnvH EnvR v t} -> 
  {typeOfV Gamma EnvH EnvR' v t}.
intros TypeOf ValueHyp.  
 case TypeOf(keep).
case H1.
search.
search.
search.


/* TAL1: typeOfH types with typeOfHvl, and typeOfR types with typeOfV */

Define typeOfH: envH -> envR -> mapH -> prop by
typeOfH EnvH EnvR MapH := forall l, forall t, 
{lookupEnvH EnvH l t} -> 
exists e, {lookupMapH MapH l e} /\ {typeOfHvl (nilEnvT) EnvH EnvR e t}.

Define typeOfR: envH -> envR -> mapR -> prop by
typeOfR EnvH EnvR MapR := forall l, forall t, 
{lookupEnvR EnvR l t} -> 
exists e, {lookupMapR MapR l e} /\ {typeOfV (nilEnvT) EnvH EnvR e t}.

Theorem Uniqueness-of-lookupMap-H : 
  forall map L e1 e2, 
  {lookupMapH map L e1} -> 
  {lookupMapH map L e2} -> 
  e1 = e2.
skip.

Theorem Uniqueness-of-lookupMap-R : 
  forall map L e1 e2, 
  {lookupMapR map L e1} -> 
  {lookupMapR map L e2} -> 
  e1 = e2.
skip.


Theorem  Find-type-in-env-byLookupR  :
    forall EnvH EnvR map L e T,
    {lookupMapR map L e} ->
    typeOfR EnvH EnvR map ->
	{lookupEnvR EnvR L T} ->
    {typeOfV (nilEnvT) EnvH EnvR e T}. 
intros Lookup typeOfH LookupEnv.
	case typeOfH(keep).
	apply H1 to LookupEnv.
	apply Uniqueness-of-lookupMap-R to Lookup H2.
	search.


Theorem Uniqueness-of-lookupEnv-H : 
  forall env L e1 e2, 
  {lookupEnvH env L e1} -> 
  {lookupEnvH  env L e2} -> 
  e1 = e2.
skip.

Theorem excluded_middle_labels-H : 
  forall (l1 :labelH) l2, 
  (l1 = l2) \/ (l1 = l2 -> false).
skip.

Theorem update_implies_lookup-H :
  forall map l map' e,
  {updateMapH map l e map'} -> {lookupMapH map' l e}.
induction on 1. intros Main.
  StUpdate : case Main.
  search.
  apply IH to StUpdate. search.

Theorem inequality_contradiction-H : 
  forall (l : labelH),
    (l = l -> false) ->
    false.
intros Contra. Equal : assert l = l. apply Contra to Equal.

Theorem lookup_when_inequal_labels-H:
  forall l1 l2 map map' e1 e2,
    (l1 = l2 -> false) ->
    {updateMapH map l1 e1 map'}    ->
    {lookupMapH map l2 e2} ->
    {lookupMapH map' l2 e2}.
induction on 2.
  intros Lanld STupdate STlookup.
  STupdate : case STupdate.
      case STlookup.
          apply inequality_contradiction-H to Lanld.
          search.
STlookup : case STlookup.
          search.
          apply IH to Lanld STupdate STlookup. search.


/* TAL1: typeOf-updateH uses TypeOfHvl rather than typeOf
   proof is the same */

Theorem typeOfHvl-updateH: 
    forall envH envR map map' e T L,
      typeOfH envH envR map ->
	  	{lookupEnvH envH L T} ->
    {typeOfHvl nilEnvT envH envR e T} ->
      {updateMapH map L e map'} ->
      typeOfH envH envR map'.
intros typeOfH LookupEnv TypeOfE Update. 
	  typeOfHExpanded: case typeOfH.
	  unfold.
	  intros LookupEnvHOfGoal.
Landl : apply excluded_middle_labels-H with l1 = L, l2 = l.
	  Landl : case Landl.
% l = L
	  apply Uniqueness-of-lookupEnv-H to LookupEnvHOfGoal LookupEnv.
	  apply update_implies_lookup-H to Update.
	  search.
% l != L
	  LookupMap : apply typeOfHExpanded to LookupEnvHOfGoal.
	  apply lookup_when_inequal_labels-H to Landl Update LookupMap.
	  search.


/* TAL1: typeOf-weakening-H uses TypeOfHvl rather than typeOf
   slight modification in proof, it uses typeOfW-weakening-H */

Theorem typeOf-weakening-H :
  forall gamma EnvH EnvR e t EnvH',
    {typeOfHvl gamma EnvH EnvR e t} ->
    {subsetEnvH EnvH EnvH'} ->
    {typeOfHvl gamma EnvH' EnvR e t}.
intros Main Subset. case Main.
  apply TypeOfW-weakening-H to H1 Subset.
  apply TypeOfW-weakening-H to H2 Subset.
  search.
apply Type-state-envs-weakening-H to H1 Subset.
  search.


/* TAL1: TypeOf-extend-prelim-H uses TypeOfHvl rather than typeOf
   proof is the same */

Theorem TypeOf-extend-prelim-H:  
    forall envH envR map E T l,  
      typeOfH envH envR map ->  
      {typeOfHvl nilEnvT envH envR E T} ->  
      typeOfH (consEnvH l T envH)  envR (consMapH l E map).
intros typeOfHvl TypeOfE.
typeOfHvlExpanded: case typeOfHvl.
unfold.
intros LookupEnv.
LookupEnv: case LookupEnv.
  witness E. split.
  search.
  SubsetEnvH: assert {subsetEnvH envH (consEnvH l1 t envH)}.
  apply typeOf-weakening-H to TypeOfE SubsetEnvH.
  search.
  typeOfHvlFormulae0: apply typeOfHvlExpanded to LookupEnv.
  witness e. 
  split.
  search. 
  SubsetEnvH: assert {subsetEnvH envH (consEnvH l T envH)}.
  apply typeOf-weakening-H to typeOfHvlFormulae1 _ with EnvH' = (consEnvH l T envH). 
  search.

Theorem TypeOf-extendH : 
  forall map E map' L T env envR,  
  {addMapH map E map' L} -> 
  typeOfH (consEnvH L T env) envR (consMapH L E map) ->
  typeOfH (consEnvH L T env) envR map'.
induction on 1. intros Main Lookup.
  Subset: case Main.
  search.

Theorem Store-stores-values-H : 
	  	forall map l e,
	  	{lookupMapH map l e} -> 
	  	{value e}.
skip.


/* TAL1: TypeOf-weakening-for-extns-H, slight modification, backchain TypeOfV-weakening-H instead of backchain Type-state-envs-weakening-H. */

Theorem TypeOf-weakening-for-extns-H: 
 	forall EnvH EnvR L T R,
 	typeOfR EnvH EnvR R ->
 	typeOfR (consEnvH (succLabelH L) T EnvH) EnvR R.
	intros TypeOfR.
TypeOfRExpanded: case TypeOfR. 
unfold. intros LookupFromGoal.
FromTypeOfR : apply TypeOfRExpanded to LookupFromGoal. 
exists e. split. search. 
backchain TypeOfV-weakening-H.


/* TAL1: We use only Find-type-in-env-byLookupH and not Find-type-in-envH. This lemma uses typeOfHvl rather than typeOf */

Theorem Find-type-in-env-byLookupH :
    forall EnvH EnvR map L e T,
    {lookupMapH map L e} ->
    typeOfH EnvH EnvR map ->
    {lookupEnvH EnvH L T} ->
    {typeOfHvl (nilEnvT) EnvH EnvR e T}.
intros Lookup TypeH LookupEnv.
  case TypeH(keep).
  apply H1 to LookupEnv.
  apply Uniqueness-of-lookupMap-H to Lookup H2.
  search.

Theorem Uniqueness-of-lookupEnv-R : 
  forall env L e1 e2, 
  {lookupEnvR env L e1} -> 
  {lookupEnvR  env L e2} -> 
  e1 = e2.
skip.

Theorem excluded_middle_labels-R : 
  forall (l1 :register) l2, 
  (l1 = l2) \/ (l1 = l2 -> false).
skip.

Theorem update_implies_lookup-R :
  forall map l map' e,
  {updateMapR map l e map'} ->
  {lookupMapR map' l e}.
induction on 1. intros Main.
  StUpdate : case Main.
  search.
  apply IH to StUpdate. search.


Theorem update_implies_lookupEnv-R : 
  forall env l T env',
  {updateEnvR env l T env'} ->
  {lookupEnvR env' l T}.
induction on 1. intros Main.
  StUpdate : case Main.
  search.
  apply IH to StUpdate. search.


Theorem inequality_contradiction-R : 
  forall (l : register),
    (l = l -> false) ->
    false.
intros Contra. Equal : assert l = l. apply Contra to Equal.


Theorem lookup_when_inequal_labels-R :
  forall l1 l2 map map' e1 e2,
    (l1 = l2 -> false) ->
    {updateMapR map l1 e1 map'}    ->
    {lookupMapR map l2 e2} ->
    {lookupMapR map' l2 e2}.
induction on 2.
  intros Lanld STupdate STlookup.
  STupdate : case STupdate.
      case STlookup.
          apply inequality_contradiction-R to Lanld.
