/* TAL2: The following three lemmas have been added: lookupEnvR-weakening-R, updateEnvR-weakening-R, transitivity-register_file_subtype. */ 
/* TAL2: updateEnvR-weakening-R makes use lemma register_file_subtype-cons-weakening-R, also added. */ 

Theorem lookupEnvR-weakening-R: forall EnvR Z T EnvR', 
	{lookupEnvR EnvR Z T} -> 
	{register_file_subtype EnvR EnvR'} -> 
	{lookupEnvR EnvR' Z T}. 
induction on 2. intros. case H2(keep). 
case H1. 
Land : apply excluded_middle_labels-R with l1 = L, l2 = Z. 
case Land. 
assert {lookupEnvR (consEnvR Z T1 Rest) Z T1}.
apply Uniqueness-of-lookupEnv-R to H1 H5.
search. 
case H1. search. 
apply IH to H6 H4. search. 


Theorem register_file_subtype-cons-weakening-R: forall EnvR Z T EnvR' EnvRnew, 
	{register_file_subtype EnvR EnvR'} -> 
	{updateEnvR EnvR' Z T EnvRnew} ->
	{register_file_subtype (consEnvR Z T EnvR) EnvRnew}. 
induction on 1. intros. 
apply update_implies_lookupEnv-R to H2. 
case H1(keep). 
search. 
apply IH to H5 H2.
case H6(keep).
Land : apply excluded_middle_labels-R with l1 = L, l2 = Z. 
case Land. 
assert {lookupEnvR (consEnvR Z T (consEnvR Z T1 Rest)) Z T}. 
assert {lookupEnvR (consEnvR Z T (consEnvR Z T1 Rest)) Z T1}. 
apply Uniqueness-of-lookupEnv-R to H9 H10.
search. 
case H6.
apply lookup_when_inequal_labels-EnvR to H9 H2 H4. 
search. 


Theorem updateEnvR-weakening-R: forall EnvR Z T EnvR' EnvRnew, 
	{updateEnvR EnvR Z T EnvRnew} -> 
	{register_file_subtype EnvR EnvR'} -> 
	exists EnvRnew', 
	{updateEnvR EnvR' Z T EnvRnew'} /\
	{register_file_subtype EnvRnew EnvRnew'}. 
induction on 1. intros. case H1(keep). 
case H2(keep). 
	assert (forall EnvR Z1 T1 T2, {lookupEnvR EnvR Z1 T1} -> exists EnvNew, {updateEnvR EnvR Z1 T2 EnvNew}). 
	induction on 1. intros Tmp. case Tmp. search. 
	apply IH1 to H5 with T2 = T2. search. 
	apply H5 to H3 with T2 = T.
exists EnvNew. split. search. 
apply register_file_subtype-cons-weakening-R to H4 H6. search. 
%%%%
case H2. 
apply IH to H3 H5.
exists EnvRnew'. split. search. 
Land : apply excluded_middle_labels-R with l1 = L1, l2 = Z. 
case Land. 
apply update_implies_lookupEnv-R to H3.
assert {lookupEnvR (consEnvR Z E1 MU') Z E1}.
assert {lookupEnvR (consEnvR Z E1 MU') Z T}.
apply Uniqueness-of-lookupEnv-R to H9 H10.
apply update_implies_lookupEnv-R to H6.
search. 
apply lookup_when_inequal_labels-EnvR to H8 H6 H4. 
search. 



Theorem transitivity-register_file_subtype : forall EnvR1 EnvR2 EnvR3, 
	{register_file_subtype EnvR1 EnvR2} -> 
	{register_file_subtype EnvR2 EnvR3} -> 
	{register_file_subtype EnvR1 EnvR3}. 
induction on 1. intros. case H1. 
search.
apply IH to H4 H2. 
Lemma : assert forall EnvRFirst EnvRSec L T,  {register_file_subtype EnvRFirst EnvRSec} -> {lookupEnvR EnvRFirst L T} -> {lookupEnvR EnvRSec L T}. 
		induction on 1. 
		intros. case H6.
			case H7.
			Land : apply excluded_middle_labels-R with l1 = L1, l2 = L2. 
			case Land. 
			assert {lookupEnvR (consEnvR L2 T2 Rest1) L2 T2}.
			apply Uniqueness-of-lookupEnv-R to H7 H10.
			search. 
			case H7.
			search. 
			apply IH1 to H9 H11. 
			search. 
apply Lemma to H2 H3. 
search. 


/* Type-state-envs-weakening-R is the second theorem that models asm's Irrelevance-Env-for-ValueTyping-R. 
   Type-state-envs-weakening-R works with typeOf */

Theorem Type-state-envs-weakening-R:
  forall gamma, forall EnvH, forall EnvR, forall e, forall t, forall EnvR',
    {typeOf gamma EnvH EnvR e t} ->
    {register_file_subtype EnvR EnvR'} ->
    {typeOf gamma EnvH EnvR' e t}.
IH0 : induction on 1. intros Main Subset.
Typing0: case Main(keep). 
% halt
search.
% add 
apply lookupEnvR-weakening-R to Typing0 _. 
apply lookupEnvR-weakening-R to Typing1 _. 
apply Irrelevance-Env-for-ValueTyping-R to Typing2 with EnvR' = EnvR'.
apply updateEnvR-weakening-R to Typing4 _.
apply IH0 to Typing3 _. 
search. 
% end add
% mul 
apply lookupEnvR-weakening-R to Typing0 _. 
apply lookupEnvR-weakening-R to Typing1 _. 
apply Irrelevance-Env-for-ValueTyping-R to Typing2 with EnvR' = EnvR'.
apply updateEnvR-weakening-R to Typing4 _.
apply IH0 to Typing3 _. 
search. 
% end mul
% load 
apply lookupEnvR-weakening-R to Typing0 _. 
apply lookupEnvR-weakening-R to Typing1 _. 
apply updateEnvR-weakening-R to Typing4 _.
apply IH0 to Typing3 _. 
search. 
% end load
% malloc 
apply lookupEnvR-weakening-R to Typing0 _. 
apply updateEnvR-weakening-R to Typing2 _.
apply IH0 to Typing1 _. 
search. 
% end malloc
% move 
apply lookupEnvR-weakening-R to Typing0 _. 
apply Irrelevance-Env-for-ValueTyping-R to Typing1 with EnvR' = EnvR'.
apply updateEnvR-weakening-R to Typing3 _.
apply IH0 to Typing2 _. 
search. 
% end move
% store 
apply lookupEnvR-weakening-R to Typing0 _. 
apply lookupEnvR-weakening-R to Typing2 _. 
apply updateEnvR-weakening-R to Typing5 _.
apply IH0 to Typing4 _. 
search. 
% end store
% jmp 
apply Irrelevance-Env-for-ValueTyping-R to Typing0 with EnvR' = EnvR'.
Transitivity: apply transitivity-register_file_subtype to _ _. 
search. 
% end jmp
% bnz 
apply lookupEnvR-weakening-R to Typing0 _. 
apply Irrelevance-Env-for-ValueTyping-R to Typing1 with EnvR' = EnvR'.
Transitivity: apply transitivity-register_file_subtype to _ _. 
apply IH0 to Typing2 Transitivity. 
search. 
% end bnz

/* TAL1: TypeOf-strong-updateR uses typeOfV rather than typeOf */
   
Theorem TypeOf-strong-updateR: 
    %assert 
	forall envH mapR mapR' envR envR' e T L,
    typeOfR envH envR mapR ->
    {updateEnvR envR L T envR'} ->
	{typeOfV nilEnvT envH envR e T} ->
    {updateMapR mapR L e mapR'} ->
    typeOfR envH envR' mapR'. 
    intros TypeOfH LookupEnv TypeOfE Update.
	TmpLookup : apply update_implies_lookup-R  to Update. 
	TmpValue : apply Store-stores-values-R  to TmpLookup. 
	TypeOfE : assert {typeOfV nilEnvT envH envR' e T}. 
	backchain Irrelevance-Env-for-ValueTyping-R. 
    TypeOfHExpanded: case TypeOfH.
    unfold.
    intros LookupEnvHOfGoal.
    Landl : apply excluded_middle_labels-R with l1 = L, l2 = l.
    Landl : case Landl.
    % l = L
    apply update_implies_lookup-R to Update.
    apply update_implies_lookupEnv-R to LookupEnv. 
    apply Uniqueness-of-lookupEnv-R to LookupEnvHOfGoal H2.
    search.
    % l != L
    LookkupForTypeOfH : apply lookup_when_inequal_labels-pre-EnvR to Landl LookupEnv LookupEnvHOfGoal. 
    LookupMap : apply TypeOfHExpanded to LookkupForTypeOfH.
    apply lookup_when_inequal_labels-R to Landl Update LookupMap.
    Value: apply Store-stores-values-R to LookupMap. 
    exists e1. split. search. 
    backchain Irrelevance-Env-for-ValueTyping-R.
		
	
/* TAL 1: TypeOf-weakening-for-extns-R, backchain TypeOfV-weakening-H instead of backchain Type-state-envs-weakening-H. */

 Theorem TypeOf-weakening-for-extns-R: 
 	forall EnvH EnvR L T R,
 	typeOfR EnvH EnvR R ->
 	typeOfR (consEnvH (succLabelH L) T EnvH) EnvR R.
	intros TypeOfR.
  TypeOfRExpanded: case TypeOfR. 
  unfold. intros LookupFromGoal.
  FromTypeOfR : apply TypeOfRExpanded to LookupFromGoal. 
  exists e. split. search. 
  backchain TypeOfV-weakening-H.
  
  

Theorem TypeOf-weakening-H: 
  forall EnvH, forall EnvR, forall map, forall EnvR',
  typeOfH EnvH EnvR map ->
  typeOfH EnvH EnvR' map.
intros Main.  
TypeOfExpanded: case Main(keep).  
unfold.  
intros Main1.  
apply TypeOfExpanded to Main1.  
apply Store-stores-values-H to H1.  
witness e.  
case H3(keep).
case H2(keep).
case H2(keep).
case H2(keep).

Theorem TypeOf-weakening-R: forall EnvH, forall EnvR, forall map, typeOfR EnvH EnvR map -> typeOfR EnvH EnvR map. 
intros Main.  
search. 


/* TAL 1: Type-preservation, modifications are marked within the proof. */
/* TAL 2: General modification: Irrelevance-Env-for-ValueTyping-R does not take any longer the premise {value v}, 
          then when tal1.thm has, for example: apply Irrelevance-Env-for-ValueTyping-R to TypingInsertedV3 Prem3 with EnvR' = EnvR'.  we omit passing Prem3. */

Theorem Type-preservation:
  forall EnvH, forall EnvR, forall e, forall typ, forall H, forall R, forall e', forall H', forall R',
  {typeOf (nilEnvT) EnvH EnvR e typ} ->
  typeOfH EnvH EnvR H -> 
  typeOfR EnvH EnvR R ->
  {step e H R e' H' R'} -> 
  exists EnvH', exists EnvR', 
  {subsetEnvH EnvH EnvH'} /\ {typeOf (nilEnvT) EnvH' EnvR' e' typ} /\ 
  typeOfH EnvH' EnvR' H' /\ typeOfR EnvH' EnvR' R'.
IH0 : induction on 1. intros Main TypeOfH TypeOfR Step. Typing0: case Main.  

/* TAL1: Here, some cases of 'case Main' have been removed: Example, num is a case in asm_jmp_bnz but not in TAL because here it is typed with typeOfV and not typeOf, therefore not here. */ 

Beginshalt: apply Step.
Prem0: case Step(keep).

Beginsadd: apply Step. 
Prem0: case Step(keep).  
TypeOfVarZd: apply Typing0. 
TypeOfVarZs: apply Typing1. 
TypeOfVarV1: apply Typing2. 
TypeOfVarE: apply Typing3. 
TypeOfVarV2: apply Find-type-in-env-byLookupR to Prem0 TypeOfR TypeOfVarZs with EnvH = EnvH.  
TypeOfVarV3: apply Find-type-user-defined-addition to Prem1 TypeOfVarV1 TypeOfVarV2.  
TypeOfR': apply TypeOf-strong-updateR to TypeOfR Typing4 TypeOfVarV3 Prem2.  
Temporary: apply TypeOf-weakening-H to TypeOfH with EnvR' = EnvR'.  
