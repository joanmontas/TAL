search.
case Typing2.
assert {typeOfV nilEnvT EnvH EnvR V' T}.
apply TypeOf-strong-updateR to TypeOfR Typing4 H7 Prem3.
witness EnvH.
witness EnvR'.
split.
search.
search.
backchain TypeOf-weakening-H.
search.

/* TAL1: case of malloc, modification for handling array.  */

Beginmalloc: apply Step.
Prem0: case Step(keep).
witness (consEnvH LNewH (arrayT T1 i0 T2 i0) EnvH).
witness EnvR'.
split.
search.
SubFact: assert {subsetEnvH EnvH (consEnvH LNewH (arrayT T1 i0 T2 i0) EnvH)}.
apply Type-state-envs-weakening-H to Typing1 SubFact.
search.
HNEW_R': apply TypeOf-weakening-H to TypeOfH with EnvR' = EnvR'.
ArrTyp: assert {typeOfHvl nilEnvT EnvH EnvR' (array (junk T1) (junk T2)) (arrayT T1 i0 T2 i0)}.
HNEW_Ext: apply TypeOf-extend-prelim-H to HNEW_R' ArrTyp with l = LNewH.
apply TypeOf-extendH to Prem0 HNEW_Ext.
search.
case Prem0.
Reg_Ext: apply TypeOf-weakening-for-extns-R to TypeOfR with L = L, T = (arrayT T1 i0 T2 i0).
PtrTyp: assert {typeOfV nilEnvT (consEnvH (succLabelH L) (arrayT T1 i0 T2 i0) EnvH) EnvR (labelH (succLabelH L)) (refH (arrayT T1 
i0 T2 i0))}.
apply TypeOf-strong-updateR to Reg_Ext Typing2 PtrTyp Prem1.
search.

/* TAL1: end case of malloc */


