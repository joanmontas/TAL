Specification "tal2". 
Import "tal2User". 

/* Obtained by editing tal1.thm. 
   Comments are inserted only where modifications/additions from tal1 were needed, and are tagged TAL2 
   Below, we refer to asm_jmp_bnz simply as 'asm' for the sake of simplicity */

Theorem existence_of_update : forall EnvR Zd E, exists EnvR', {updateEnvR EnvR Zd E EnvR'}. skip. 
Theorem update_of_register_subtype : forall EnvR1 EnvR2 Zd T EnvR1' EnvR2', {register_file_subtype EnvR1 EnvR2} -> {updateEnvR EnvR1 Zd T EnvR1'} -> {updateEnvR EnvR2 Zd T EnvR2'} -> {register_file_subtype EnvR1' EnvR2'}. skip. 

Theorem Lookup-store-weakening-H:
  forall env, forall env', forall l, forall t,
    {subsetEnvH env env'} ->
    {lookupEnvH env l t} ->
    {lookupEnvH env' l t}.
IH0 : induction on 1. intros Main Lookup. Subset: case Main.
 search.
 apply IH0 to Subset Lookup.
 search.

 
/* TAL1: tal has multiple typeOf relations rather than just one typeOf. 
   TypeOfWval-weakening-H and typeOfV-weakening-H are asm's TypeOf-weakening-H but for typeOfWval and typeOfV, respectively. 
   Differently from asm, Type-state-envs-weakening-H uses typeOfV-weakening-H, which uses TypeOfWval-weakening-H */

Theorem TypeOfWval-weakening-H :
  forall EnvH e t EnvH',
    {typeOfWval EnvH e t} ->
    {subsetEnvH EnvH EnvH'} ->
    {typeOfWval EnvH' e t}.
intros Main Subset.
case Main. 
search.
apply Lookup-store-weakening-H to Subset H1. search.

Theorem TypeOfW-weakening-H :
  forall EnvH e t EnvH' FL,
    {typeOfW EnvH e t FL} ->
    {subsetEnvH EnvH EnvH'} ->
    {typeOfW EnvH' e t FL}.
intros Main Subset.
case Main. 
apply TypeOfWval-weakening-H to H1 Subset. search. 
search. 

Theorem TypeOfV-weakening-H :
  forall EnvH EnvR e t EnvH',
    {typeOfV EnvH EnvR e t} ->
    {subsetEnvH EnvH EnvH'} ->
    {typeOfV EnvH' EnvR e t}.
intros Main Subset.
  case Main.
  apply TypeOfWval-weakening-H to H1 Subset.
  search.
  

/* TAL1: slight modification to derive typeOfV formulae to satisfy the typeOfV premises of typeOf, these are MaddV, MmultV, etc. below. */

Theorem Type-state-envs-weakening-H:
  forall EnvH, forall EnvR, forall e, forall t, forall EnvH',
    {typeOf EnvH EnvR e t} ->
    {subsetEnvH EnvH EnvH'} ->
    {typeOf EnvH' EnvR e t}.
IH0 : induction on 1. intros Main Subset.
Typing0: case Main(keep). 
search.
MaddV: apply TypeOfV-weakening-H to Typing2 Subset.
Madd: apply IH0 to Typing3 Subset.  
search.  
MmultV: apply TypeOfV-weakening-H to Typing2 Subset.  
Mmult: apply IH0 to Typing3 Subset.  
search.
Mload: apply IH0 to Typing3 Subset.  
search.  
Mmalloc: 
apply IH0 to Typing1 Subset.  
search.  
MmoveV: apply TypeOfV-weakening-H to Typing1 Subset.
Mmove: apply IH0 to Typing2 Subset.  
search. 
Mstore: apply IH0 to Typing5 Subset.  
search.  
MjmpV: apply TypeOfV-weakening-H to Typing0 Subset.
search.  
MbnzV: apply TypeOfV-weakening-H to Typing1 Subset.  
Mbnz: apply IH0 to Typing2 Subset.  
search.


/* TAL1: slight modification, Irrelevance-Env-for-ValueTyping-R uses typeOfV */
/* TAL2: Irrelevance-Env-for-ValueTyping-R is now two theorems, 1) Irrelevance-Env-for-ValueTyping-R below that works with typeOfV, 2) and Type-state-envs-weakening-R that works with typeOf */
/* TAL2: optimization, Irrelevance-Env-for-ValueTyping-R does not neet the premise {value v} because it works with typeOfV, that premise has been removed */
/* TAL2: slight modification, theorem works for Gamma rather than nilEnvH, same proof works. Type-state-envs-weakening-R needs Gamma. For asm_bnz_jmp and tal1, nilEnvH was fine. */

Theorem Irrelevance-Env-for-ValueTyping-R: 
  forall EnvH, forall EnvR, forall v, forall t, forall EnvR',
  {typeOfV EnvH EnvR v t} -> 
  {typeOfV EnvH EnvR' v t}.
intros TypeOf ValueHyp.  
 case TypeOf(keep).
case H1.
search.
search.


/* TAL1: typeOfH types with typeOfHvl, and typeOfR types with typeOfV */

Define typeOfH: envH -> mapH -> prop by
typeOfH EnvH MapH := forall l, forall t, 
{lookupEnvH EnvH l t} -> 
exists e, {lookupMapH MapH l e} /\ {typeOfHvl EnvH e t}.

Define typeOfR: envH -> envR -> mapR -> prop by
typeOfR EnvH EnvR MapR := forall l, forall t, 
{lookupEnvR EnvR l t} -> 
exists e, {lookupMapR MapR l e} /\ {typeOfWval EnvH e t}.

Theorem Uniqueness-of-lookupMap-H : 
  forall map L e1 e2, 
  {lookupMapH map L e1} -> 
  {lookupMapH map L e2} -> 
  e1 = e2.
skip.

Theorem Uniqueness-of-lookupMap-R : 
  forall map L e1 e2, 
  {lookupMapR map L e1} -> 
  {lookupMapR map L e2} -> 
  e1 = e2.
skip.


Theorem  Find-type-in-env-byLookupR  :
    forall EnvH EnvR map L e T,
    {lookupMapR map L e} ->
    typeOfR EnvH EnvR map ->
	{lookupEnvR EnvR L T} ->
    {typeOfV EnvH EnvR e T}. 
intros Lookup typeOfH LookupEnv.
	case typeOfH(keep).
	apply H1 to LookupEnv.
	apply Uniqueness-of-lookupMap-R to Lookup H2.
	search.


Theorem Uniqueness-of-lookupEnv-H : 
  forall env L e1 e2, 
  {lookupEnvH env L e1} -> 
  {lookupEnvH  env L e2} -> 
  e1 = e2.
skip.

Theorem excluded_middle_labels-H : 
  forall (l1 :labelH) l2, 
  (l1 = l2) \/ (l1 = l2 -> false).
skip.

Theorem update_implies_lookup-H :
  forall map l map' e,
  {updateMapH map l e map'} -> {lookupMapH map' l e}.
induction on 1. intros Main.
  StUpdate : case Main.
  search.
  apply IH to StUpdate. search.

Theorem inequality_contradiction-H : 
  forall (l : labelH),
    (l = l -> false) ->
    false.
intros Contra. Equal : assert l = l. apply Contra to Equal.

Theorem lookup_when_inequal_labels-H:
  forall l1 l2 map map' e1 e2,
    (l1 = l2 -> false) ->
    {updateMapH map l1 e1 map'}    ->
    {lookupMapH map l2 e2} ->
    {lookupMapH map' l2 e2}.
induction on 2.
  intros Lanld STupdate STlookup.
  STupdate : case STupdate.
      case STlookup.
          apply inequality_contradiction-H to Lanld.
          search.
STlookup : case STlookup.
          search.
          apply IH to Lanld STupdate STlookup. search.


/* TAL1: typeOf-updateH uses TypeOfHvl rather than typeOf
   proof is the same */

Theorem typeOfHvl-updateH: 
    forall envH map map' e T L,
      typeOfH envH map ->
	  	{lookupEnvH envH L T} ->
    {typeOfHvl envH e T} ->
      {updateMapH map L e map'} ->
      typeOfH envH map'.
intros typeOfH LookupEnv TypeOfE Update. 
	  typeOfHExpanded: case typeOfH.
	  unfold.
	  intros LookupEnvHOfGoal.
Landl : apply excluded_middle_labels-H with l1 = L, l2 = l.
	  Landl : case Landl.
% l = L
	  apply Uniqueness-of-lookupEnv-H to LookupEnvHOfGoal LookupEnv.
	  apply update_implies_lookup-H to Update.
	  search.
% l != L
	  LookupMap : apply typeOfHExpanded to LookupEnvHOfGoal.
	  apply lookup_when_inequal_labels-H to Landl Update LookupMap.
	  search.


/* TAL1: typeOf-weakening-H uses TypeOfHvl rather than typeOf
   slight modification in proof, it uses TypeOfWval-weakening-H */

Theorem typeOf-weakening-H :
  forall EnvH e t EnvH',
    {typeOfHvl EnvH e t} ->
    {subsetEnvH EnvH EnvH'} ->
    {typeOfHvl EnvH' e t}.
intros Main Subset. case Main.
  apply TypeOfW-weakening-H to H1 Subset.
  apply TypeOfW-weakening-H to H2 Subset.
  apply TypeOfW-weakening-H to H3 Subset.
  apply TypeOfW-weakening-H to H4 Subset.
  apply TypeOfW-weakening-H to H5 Subset.
  apply TypeOfW-weakening-H to H6 Subset.
  search. 
apply Type-state-envs-weakening-H to H1 Subset.
  search.


/* TAL1: TypeOf-extend-prelim-H uses TypeOfHvl rather than typeOf
   proof is the same */

Theorem TypeOf-extend-prelim-H:  
    forall envH map E T l,  
      typeOfH envH map ->  
      {typeOfHvl envH E T} ->  
      typeOfH (consEnvH l T envH)  (consMapH l E map).
intros typeOfHvl TypeOfE.
typeOfHvlExpanded: case typeOfHvl.
unfold.
intros LookupEnv.
LookupEnv: case LookupEnv.
  witness E. split.
  search.
  SubsetEnvH: assert {subsetEnvH envH (consEnvH l1 t envH)}.
  apply typeOf-weakening-H to TypeOfE SubsetEnvH.
  search.
  typeOfHvlFormulae0: apply typeOfHvlExpanded to LookupEnv.
  witness e. 
  split.
  search. 
  SubsetEnvH: assert {subsetEnvH envH (consEnvH l T envH)}.
  apply typeOf-weakening-H to typeOfHvlFormulae1 _ with EnvH' = (consEnvH l T envH). 
  search.

Theorem TypeOf-extendH : 
  forall map E map' L T env,  
  {addMapH map E map' L} -> 
  typeOfH (consEnvH L T env) (consMapH L E map) ->
  typeOfH (consEnvH L T env) map'.
induction on 1. intros Main Lookup.
  Subset: case Main.
  search.


/* TAL1: TypeOf-weakening-for-extns-H, slight modification, backchain TypeOfV-weakening-H instead of backchain Type-state-envs-weakening-H. */

Theorem TypeOf-weakening-for-extns-H: 
 	forall EnvH EnvR L T R,
 	typeOfR EnvH EnvR R ->
 	typeOfR (consEnvH (succLabelH L) T EnvH) EnvR R.
	intros TypeOfR.
TypeOfRExpanded: case TypeOfR. 
unfold. intros LookupFromGoal.
FromTypeOfR : apply TypeOfRExpanded to LookupFromGoal. 
exists e. split. search. 
backchain TypeOfWval-weakening-H.

/* TAL1: We use only Find-type-in-env-byLookupH and not Find-type-in-envH. This lemma uses typeOfHvl rather than typeOf */

Theorem Find-type-in-env-byLookupH :
    forall EnvH map L e T,
    {lookupMapH map L e} ->
    typeOfH EnvH map ->
    {lookupEnvH EnvH L T} ->
    {typeOfHvl EnvH e T}.
intros Lookup TypeH LookupEnv.
  case TypeH(keep).
  apply H1 to LookupEnv.
  apply Uniqueness-of-lookupMap-H to Lookup H2.
  search.

Theorem Uniqueness-of-lookupEnv-R : 
  forall env L e1 e2, 
  {lookupEnvR env L e1} -> 
  {lookupEnvR  env L e2} -> 
  e1 = e2.
skip.

Theorem excluded_middle_labels-R : 
  forall (l1 :register) l2, 
  (l1 = l2) \/ (l1 = l2 -> false).
skip.

Theorem update_implies_lookup-R :
  forall map l map' e,
  {updateMapR map l e map'} ->
  {lookupMapR map' l e}.
induction on 1. intros Main.
  StUpdate : case Main.
  search.
  apply IH to StUpdate. search.


Theorem update_implies_lookupEnv-R : 
  forall env l T env',
  {updateEnvR env l T env'} ->
  {lookupEnvR env' l T}.
induction on 1. intros Main.
  StUpdate : case Main.
  search.
  apply IH to StUpdate. search.


Theorem inequality_contradiction-R : 
  forall (l : register),
    (l = l -> false) ->
    false.
intros Contra. Equal : assert l = l. apply Contra to Equal.


Theorem lookup_when_inequal_labels-R :
  forall l1 l2 map map' e1 e2,
    (l1 = l2 -> false) ->
    {updateMapR map l1 e1 map'}    ->
    {lookupMapR map l2 e2} ->
    {lookupMapR map' l2 e2}.
induction on 2.
  intros Lanld STupdate STlookup.
  STupdate : case STupdate.
      case STlookup.
          apply inequality_contradiction-R to Lanld.
          search.
STlookup : case STlookup.
          search.
          apply IH to Lanld STupdate STlookup. search.


Theorem lookup_when_inequal_labels-pre-EnvR:
		  forall l1 l2 map map' e1 e2,
		    (l1 = l2 -> false) ->
		    {updateEnvR map l1 e1 map'}    ->
		    {lookupEnvR map' l2 e2} ->
		    {lookupEnvR map l2 e2}.
        induction on 2.
        intros Lanld STupdate STlookup.
          STupdate : case STupdate.
            case STlookup.
              apply inequality_contradiction-R to Lanld.
              search.
            STlookup : case STlookup.
              search.
              apply IH to Lanld STupdate STlookup. search.



/* TAL2: moved lookup_when_inequal_labels-EnvR here because other lemmas need it earlier */ 
Theorem lookup_when_inequal_labels-EnvR :
  forall l1 l2 map map' e1 e2,
    (l2 = l1 -> false) ->
    {updateEnvR map l1 e1 map'}    ->
    {lookupEnvR map l2 e2} ->
    {lookupEnvR map' l2 e2}.
induction on 2.
  intros Lanld STupdate STlookup.
  STupdate : case STupdate.
      case STlookup.
          apply inequality_contradiction-R to Lanld.
          search.
STlookup : case STlookup.
          search.
          apply IH to Lanld STupdate STlookup. search.

/* TAL2: The following three lemmas have been added: lookupEnvR-weakening-R, updateEnvR-weakening-R, transitivity-register_file_subtype. */ 
/* TAL2: updateEnvR-weakening-R makes use lemma register_file_subtype-cons-weakening-R, also added. */ 

Theorem lookupEnvR-weakening-R: forall EnvR Z T EnvR', 
	{lookupEnvR EnvR Z T} -> 
	{register_file_subtype EnvR EnvR'} -> 
	{lookupEnvR EnvR' Z T}. 
induction on 2. intros. case H2(keep). 
case H1. 
Land : apply excluded_middle_labels-R with l1 = L, l2 = Z. 
case Land. 
assert {lookupEnvR (consEnvR Z T1 Rest) Z T1}.
apply Uniqueness-of-lookupEnv-R to H1 H5.
search. 
case H1. search. 
apply IH to H6 H4. search. 


Theorem register_file_subtype-cons-weakening-R: forall EnvR Z T EnvR' EnvRnew, 
	{register_file_subtype EnvR EnvR'} -> 
	{updateEnvR EnvR' Z T EnvRnew} ->
	{register_file_subtype (consEnvR Z T EnvR) EnvRnew}. 
induction on 1. intros. 
apply update_implies_lookupEnv-R to H2. 
case H1(keep). 
search. 
apply IH to H5 H2.
case H6(keep).
Land : apply excluded_middle_labels-R with l1 = L, l2 = Z. 
case Land. 
assert {lookupEnvR (consEnvR Z T (consEnvR Z T1 Rest)) Z T}. 
assert {lookupEnvR (consEnvR Z T (consEnvR Z T1 Rest)) Z T1}. 
apply Uniqueness-of-lookupEnv-R to H9 H10.
search. 
case H6.
apply lookup_when_inequal_labels-EnvR to H9 H2 H4. 
search. 


Theorem updateEnvR-weakening-R: forall EnvR Z T EnvR' EnvRnew, 
	{updateEnvR EnvR Z T EnvRnew} -> 
	{register_file_subtype EnvR EnvR'} -> 
	exists EnvRnew', 
	{updateEnvR EnvR' Z T EnvRnew'} /\
	{register_file_subtype EnvRnew EnvRnew'}. 
induction on 1. intros. case H1(keep). 
case H2(keep). 
	assert (forall EnvR Z1 T1 T2, {lookupEnvR EnvR Z1 T1} -> exists EnvNew, {updateEnvR EnvR Z1 T2 EnvNew}). 
	induction on 1. intros Tmp. case Tmp. search. 
	apply IH1 to H5 with T2 = T2. search. 
	apply H5 to H3 with T2 = T.
exists EnvNew. split. search. 
apply register_file_subtype-cons-weakening-R to H4 H6. search. 
%%%%
case H2. 
apply IH to H3 H5.
exists EnvRnew'. split. search. 
Land : apply excluded_middle_labels-R with l1 = L1, l2 = Z. 
case Land. 
apply update_implies_lookupEnv-R to H3.
assert {lookupEnvR (consEnvR Z E1 MU') Z E1}.
assert {lookupEnvR (consEnvR Z E1 MU') Z T}.
apply Uniqueness-of-lookupEnv-R to H9 H10.
apply update_implies_lookupEnv-R to H6.
search. 
apply lookup_when_inequal_labels-EnvR to H8 H6 H4. 
search. 



Theorem transitivity-register_file_subtype : forall EnvR1 EnvR2 EnvR3, 
	{register_file_subtype EnvR1 EnvR2} -> 
	{register_file_subtype EnvR2 EnvR3} -> 
	{register_file_subtype EnvR1 EnvR3}. 
induction on 1. intros. case H1. 
search.
apply IH to H4 H2. 
Lemma : assert forall EnvRFirst EnvRSec L T,  {register_file_subtype EnvRFirst EnvRSec} -> {lookupEnvR EnvRFirst L T} -> {lookupEnvR EnvRSec L T}. 
		induction on 1. 
		intros. case H6.
			case H7.
			Land : apply excluded_middle_labels-R with l1 = L1, l2 = L2. 
			case Land. 
			assert {lookupEnvR (consEnvR L2 T2 Rest1) L2 T2}.
			apply Uniqueness-of-lookupEnv-R to H7 H10.
			search. 
			case H7.
			search. 
			apply IH1 to H9 H11. 
			search. 
apply Lemma to H2 H3. 
search. 


/* Type-state-envs-weakening-R is the second theorem that models asm's Irrelevance-Env-for-ValueTyping-R. 
   Type-state-envs-weakening-R works with typeOf */

Theorem Type-state-envs-weakening-R:
  forall EnvH, forall EnvR, forall e, forall t, forall EnvR',
    {typeOf EnvH EnvR e t} ->
    {register_file_subtype EnvR EnvR'} ->
    {typeOf EnvH EnvR' e t}.
IH0 : induction on 1. intros Main Subset.
Typing0: case Main(keep). 
% halt
search.
% add 
apply lookupEnvR-weakening-R to Typing0 _. 
apply lookupEnvR-weakening-R to Typing1 _. 
apply Irrelevance-Env-for-ValueTyping-R to Typing2 with EnvR' = EnvR'.
apply updateEnvR-weakening-R to Typing4 _.
apply IH0 to Typing3 _. 
search. 
% end add
% mul 
apply lookupEnvR-weakening-R to Typing0 _. 
apply lookupEnvR-weakening-R to Typing1 _. 
apply Irrelevance-Env-for-ValueTyping-R to Typing2 with EnvR' = EnvR'.
apply updateEnvR-weakening-R to Typing4 _.
apply IH0 to Typing3 _. 
search. 
% end mul
% load 
apply lookupEnvR-weakening-R to Typing0 _. 
apply lookupEnvR-weakening-R to Typing1 _. 
apply updateEnvR-weakening-R to Typing4 _.
apply IH0 to Typing3 _. 
search. 
% end load
% malloc 
apply lookupEnvR-weakening-R to Typing0 _. 
apply updateEnvR-weakening-R to Typing2 _.
apply IH0 to Typing1 _. 
search. 
% end malloc
% move 
apply lookupEnvR-weakening-R to Typing0 _. 
apply Irrelevance-Env-for-ValueTyping-R to Typing1 with EnvR' = EnvR'.
apply updateEnvR-weakening-R to Typing3 _.
apply IH0 to Typing2 _. 
search. 
% end move
% store 
apply lookupEnvR-weakening-R to Typing0 _. 
apply lookupEnvR-weakening-R to Typing2 _. 
UpdateEnvR' : apply existence_of_update with EnvR = EnvR', Zd = Zd, E = Arr. 
SubEnvR'' : apply update_of_register_subtype to Subset Typing4 UpdateEnvR'.
apply IH0 to Typing5 SubEnvR''. 
search. 
% end store
% jmp 
apply Irrelevance-Env-for-ValueTyping-R to Typing0 with EnvR' = EnvR'.
Transitivity: apply transitivity-register_file_subtype to _ _. 
search. 
% end jmp
% bnz 
apply lookupEnvR-weakening-R to Typing0 _. 
apply Irrelevance-Env-for-ValueTyping-R to Typing1 with EnvR' = EnvR'.
Transitivity: apply transitivity-register_file_subtype to _ _. 
apply IH0 to Typing2 Transitivity. 
search. 
% end bnz

/* TAL1: TypeOf-strong-updateR uses typeOfV rather than typeOf */
   
Theorem TypeOf-strong-updateR: 
	forall envH mapR mapR' envR envR' e T L,
    typeOfR envH envR mapR ->
    {updateEnvR envR L T envR'} ->
	{typeOfV envH envR e T} ->
    {updateMapR mapR L e mapR'} ->
    typeOfR envH envR' mapR'. 
    intros TypeOfH LookupEnv TypeOfE Update.
	TmpLookup : apply update_implies_lookup-R  to Update. 
	TypeOfE : assert {typeOfV envH envR' e T}. 
	backchain Irrelevance-Env-for-ValueTyping-R. 
    TypeOfHExpanded: case TypeOfH.
    unfold.
    intros LookupEnvHOfGoal.
    Landl : apply excluded_middle_labels-R with l1 = L, l2 = l.
    Landl : case Landl.
    % l = L
    apply update_implies_lookup-R to Update.
    apply update_implies_lookupEnv-R to LookupEnv. 
    apply Uniqueness-of-lookupEnv-R to LookupEnvHOfGoal H2.
	case TypeOfE1. 
    search.
    % l != L
    LookkupForTypeOfH : apply lookup_when_inequal_labels-pre-EnvR to Landl LookupEnv LookupEnvHOfGoal. 
    LookupMap : apply TypeOfHExpanded to LookkupForTypeOfH.
    apply lookup_when_inequal_labels-R to Landl Update LookupMap.
    exists e1. split. search. search. 
		
	
/* TAL 1: TypeOf-weakening-for-extns-R, backchain TypeOfV-weakening-H instead of backchain Type-state-envs-weakening-H. */

 Theorem TypeOf-weakening-for-extns-R: 
 	forall EnvH EnvR L T R,
 	typeOfR EnvH EnvR R ->
 	typeOfR (consEnvH (succLabelH L) T EnvH) EnvR R.
	intros TypeOfR.
  TypeOfRExpanded: case TypeOfR. 
  unfold. intros LookupFromGoal.
  FromTypeOfR : apply TypeOfRExpanded to LookupFromGoal. 
  exists e. split. search. 
  backchain TypeOfWval-weakening-H.
  
/* PROVE THIS AFTER STORE CASE IN PRESERVATION */
Theorem flag_subtyping_does_not_change_types : forall T1 FL1 T2 FL2 T3 FL3 T4 FL4 T5 FL5 T6 FL6 T1' FL1' T2' FL2' T3' FL3' T4' FL4' T5' FL5' T6' FL6', 
{flag_subtyping (arrayT T1 FL1 T2 FL2 T3 FL3 T4 FL4 T5 FL5 T6 FL6) (arrayT T1' FL1' T2' FL2' T3' FL3' T4' FL4' T5' FL5' T6' FL6')} -> 
T1 = T1' /\ T2 = T2' /\ T3 = T3' /\ T4 = T4' /\ T5 = T5' /\ T6 = T6'.
skip. 

/* PROVE THIS AFTER STORE CASE IN PRESERVATION */
Theorem flag_subtyping_does_not_turn_one_to_zero : forall T1 T1' T2 T2' I, 
{arrayT_get T1 I T1' i1} -> {arrayT_get T2 I T2' i0} -> false.
skip. 

/* PROVE THIS AFTER STORE CASE IN PRESERVATION */
Theorem flag_subtyping_is_equality_on_codeT : forall EnvR1 EnvR2, {flag_subtyping (codeT EnvR1) (codeT EnvR2)} -> EnvR1 = EnvR2. skip. 

/* TAL 1: Type-preservation, modifications are marked within the proof. */
/* TAL 2: General modification: Irrelevance-Env-for-ValueTyping-R does not take any longer the premise {value v}, 
          then when tal1.thm has, for example: apply Irrelevance-Env-for-ValueTyping-R to TypingInsertedV3 Prem3 with EnvR' = EnvR'.  we omit passing Prem3. */

Theorem Type-preservation:
  forall EnvH, forall EnvR, forall e, forall typ, forall H, forall R, forall e', forall H', forall R',
  {typeOf EnvH EnvR e typ} ->
  typeOfH EnvH H -> 
  typeOfR EnvH EnvR R ->
  {step e H R e' H' R'} -> 
  exists EnvH', exists EnvR', 
  {typeOf  EnvH' EnvR' e' typ}  /\  typeOfH EnvH' H'  /\  typeOfR EnvH' EnvR' R'.
IH0 : induction on 1. intros Main TypeOfH TypeOfR Step. Typing0: case Main.  

/* TAL1: Here, some cases of 'case Main' have been removed: Example, num is a case in asm_jmp_bnz but not in TAL because here it is typed with typeOfV and not typeOf, therefore not here. */ 

Beginshalt: apply Step.
Prem0: case Step(keep).

Beginsadd: apply Step. 
Prem0: case Step(keep).  
TypeOfVarZd: apply Typing0. 
TypeOfVarZs: apply Typing1. 
TypeOfVarV1: apply Typing2. 
TypeOfVarE: apply Typing3. 
TypeOfVarV2: apply Find-type-in-env-byLookupR to Prem0 TypeOfR TypeOfVarZs with EnvH = EnvH.  
TypeOfVarV3: apply Find-type-user-defined-addition to Prem1 TypeOfVarV1 TypeOfVarV2.  
TypeOfR': apply TypeOf-strong-updateR to TypeOfR Typing4 TypeOfVarV3 Prem2.  
witness EnvH.  
witness EnvR'.  
split.  
search.  
search. 
search. 

Beginsmult: apply Step. 
Prem0: case Step(keep).  
TypeOfVarZd: apply Typing0. 
TypeOfVarZs: apply Typing1. 
TypeOfVarV1: apply Typing2. 
TypeOfVarE: apply Typing3. 
TypeOfVarV2: apply Find-type-in-env-byLookupR to Prem0 TypeOfR TypeOfVarZs with EnvH = EnvH.  
TypeOfVarV3: apply Find-type-user-defined-multiplication to Prem1 TypeOfVarV1 TypeOfVarV2.  
TypeOfR': apply TypeOf-strong-updateR to TypeOfR Typing4 TypeOfVarV3 Prem2.  
witness EnvH.  
witness EnvR'.  
split.  
search.  
search. 
search. 


/* TAL1: case of load, modification for handling array. Handling arrays splits this one case into two cases. */

Beginload: apply Step.
Prem0: case Step(keep).
TypeOfVarL : apply Find-type-in-env-byLookupR to Prem0 TypeOfR Typing1.
typeOfWval-VarL : case TypeOfVarL. 
LookupVarL : case typeOfWval-VarL.
TypeOfVarV : apply Find-type-in-env-byLookupH to Prem1 TypeOfH LookupVarL.
case Prem2.
%% case Prem2 splits into the 6 cases of array_get based on index. 
%% array get with number i0
case Typing2.
Array1 : case TypeOfVarV.
apply flag_subtyping_does_not_change_types to LookupVarL1. 
typeOfWvalV' : case Array1(keep).
% two cases of typeOfW. first: typeOfWval
TypeOfVarV' : assert {typeOfV EnvH EnvR V' T}.
apply TypeOf-strong-updateR to TypeOfR Typing4 TypeOfVarV' Prem3.
witness EnvH.
witness EnvR'.
split.
search.
search.
search.
% two cases of typeOfW. second: typeOfW junk
FlagLookup1 : assert {arrayT_get (arrayT T i1 T2 FL2 T3 FL3 T4 FL4 T5 FL5 T6 FL6) (num i0) T i1}. 
FlagLookup2 : assert {arrayT_get (arrayT T i0 T2 FL11 T3 FL10 T4 FL9 T5 FL8 T6 FL7) (num i0) T i0}. 
apply flag_subtyping_does_not_turn_one_to_zero to FlagLookup1 FlagLookup2. 
%% array get with number i1
case Typing2.
Array1 : case TypeOfVarV.
apply flag_subtyping_does_not_change_types to LookupVarL1. 
typeOfWvalV' : case Array2(keep).
% two cases of typeOfW. first: typeOfWval
TypeOfVarV' : assert {typeOfV EnvH EnvR V' T}.
apply TypeOf-strong-updateR to TypeOfR Typing4 TypeOfVarV' Prem3.
witness EnvH.
witness EnvR'.
split.
search.
search.
search.
% two cases of typeOfW. second: typeOfW junk
FlagLookup1 : assert {arrayT_get (arrayT T1 FL1 T i1 T3 FL3 T4 FL4 T5 FL5 T6 FL6) (num i1) T i1}. 
FlagLookup2 : assert {arrayT_get (arrayT T1 FL12 T i0 T3 FL10 T4 FL9 T5 FL8 T6 FL7) (num i1) T i0}. 
apply flag_subtyping_does_not_turn_one_to_zero to FlagLookup1 FlagLookup2. 
%% array get with number i2
case Typing2.
Array1 : case TypeOfVarV.
apply flag_subtyping_does_not_change_types to LookupVarL1. 
typeOfWvalV' : case Array3(keep).
% two cases of typeOfW. first: typeOfWval
TypeOfVarV' : assert {typeOfV EnvH EnvR V' T}.
apply TypeOf-strong-updateR to TypeOfR Typing4 TypeOfVarV' Prem3.
witness EnvH.
witness EnvR'.
split.
search.
search.
search.
% two cases of typeOfW. second: typeOfW junk
FlagLookup1 : assert {arrayT_get (arrayT T1 FL1 T2 FL2 T i1 T4 FL4 T5 FL5 T6 FL6) (num i2) T i1}. 
FlagLookup2 : assert {arrayT_get (arrayT T1 FL12 T2 FL11 T i0 T4 FL9 T5 FL8 T6 FL7) (num i2) T i0}. 
apply flag_subtyping_does_not_turn_one_to_zero to FlagLookup1 FlagLookup2. 
%% array get with number i3
case Typing2.
Array1 : case TypeOfVarV.
apply flag_subtyping_does_not_change_types to LookupVarL1. 
typeOfWvalV' : case Array4(keep).
% two cases of typeOfW. first: typeOfWval
TypeOfVarV' : assert {typeOfV EnvH EnvR V' T}.
apply TypeOf-strong-updateR to TypeOfR Typing4 TypeOfVarV' Prem3.
witness EnvH.
witness EnvR'.
split.
search.
search.
search.
% two cases of typeOfW. second: typeOfW junk
FlagLookup1 : assert {arrayT_get (arrayT T1 FL1 T2 FL2 T3 FL3 T i1 T5 FL5 T6 FL6) (num i3) T i1}. 
FlagLookup2 : assert {arrayT_get (arrayT T1 FL12 T2 FL11 T3 FL10 T i0 T5 FL8 T6 FL7) (num i3) T i0}. 
apply flag_subtyping_does_not_turn_one_to_zero to FlagLookup1 FlagLookup2. 
%% array get with number i4
case Typing2.
Array1 : case TypeOfVarV.
apply flag_subtyping_does_not_change_types to LookupVarL1. 
typeOfWvalV' : case Array5(keep).
% two cases of typeOfW. first: typeOfWval
TypeOfVarV' : assert {typeOfV EnvH EnvR V' T}.
apply TypeOf-strong-updateR to TypeOfR Typing4 TypeOfVarV' Prem3.
witness EnvH.
witness EnvR'.
split.
search.
search.
search.
% two cases of typeOfW. second: typeOfW junk
FlagLookup1 : assert {arrayT_get (arrayT T1 FL1 T2 FL2 T3 FL3 T i1 T5 FL5 T6 FL6) (num i4) T i1}. 
FlagLookup2 : assert {arrayT_get (arrayT T1 FL12 T2 FL11 T3 FL10 T i0 T5 FL8 T6 FL7) (num i4) T i0}. 
apply flag_subtyping_does_not_turn_one_to_zero to FlagLookup1 FlagLookup2. 
%% array get with number i5
case Typing2.
Array1 : case TypeOfVarV.
apply flag_subtyping_does_not_change_types to LookupVarL1. 
typeOfWvalV' : case Array6(keep).
% two cases of typeOfW. first: typeOfWval
TypeOfVarV' : assert {typeOfV EnvH EnvR V' T}.
apply TypeOf-strong-updateR to TypeOfR Typing4 TypeOfVarV' Prem3.
witness EnvH.
witness EnvR'.
split.
search.
search.
search.
% two cases of typeOfW. second: typeOfW junk
FlagLookup1 : assert {arrayT_get (arrayT T1 FL1 T2 FL2 T3 FL3 T4 FL4 T5 FL5 T i1) (num i5) T i1}. 
FlagLookup2 : assert {arrayT_get (arrayT T1 FL12 T2 FL11 T3 FL10 T4 FL9 T5 FL8 T i0) (num i5) T i0}. 
apply flag_subtyping_does_not_turn_one_to_zero to FlagLookup1 FlagLookup2. 

/* TAL1: case of malloc, modifications for handling array.  */

Beginmalloc: apply Step.
Prem0: case Step(keep).

TypeOfW-E1 : assert {typeOfW EnvH (junk T1) T1 i0}. 
TypeOfW-E2 : assert {typeOfW EnvH (junk T2) T2 i0}. 
TypeOfW-E3 : assert {typeOfW EnvH (junk T3) T3 i0}. 
TypeOfW-E4 : assert {typeOfW EnvH (junk T4) T4 i0}. 
TypeOfW-E5 : assert {typeOfW EnvH (junk T5) T5 i0}. 
TypeOfW-E6 : assert {typeOfW EnvH (junk T6) T6 i0}. 
ArrTyp : assert {typeOfHvl EnvH (array (junk T1) (junk T2) (junk T3) (junk T4) (junk T5) (junk T6)) (arrayT T1 i0 T2 i0 T3 i0 T4 i0 T5 i0 T6 i0)}.  
apply TypeOf-extend-prelim-H to TypeOfH ArrTyp with l = LNewH.
case Prem0.
TypeOfRnew : apply TypeOf-weakening-for-extns-R to TypeOfR with L = L, T = (arrayT T1 i0 T2 i0 T3 i0 T4 i0 T5 i0 T6 i0).
PtrTyp: assert {typeOfV (consEnvH (succLabelH L) (arrayT T1 i0 T2 i0 T3 i0 T4 i0 T5 i0 T6 i0) EnvH) EnvR (labelH (succLabelH L)) (arrayT T1 i0 T2 i0 T3 i0 T4 i0 T5 i0 T6 i0)}.
apply TypeOf-strong-updateR to TypeOfRnew Typing2 PtrTyp Prem1.
witness (consEnvH LNewH (arrayT T1 i0 T2 i0 T3 i0 T4 i0 T5 i0 T6 i0) EnvH).
witness EnvR'.
split.
backchain Type-state-envs-weakening-H.  
search. 
search. 


/* TAL1: end case of malloc */


Beginsmove: apply Step. 
Prem0: case Step(keep).  
TypeOfVarZd: apply Typing0. 
TypeOfVarV: apply Typing1. 
TypeOfVarE: apply Typing2. 
TypeOfR': apply TypeOf-strong-updateR to TypeOfR Typing3 TypeOfVarV Prem0.  
witness EnvH.  
witness EnvR'.  
split.  
search.  
search. 
search. 



/* TAL1: case of store, modification for handling array. */
/* PROVE THIS. THIS IS THE STORE CASE IN PRESERVATION 
   REMOVE skip. 
*/

skip. 


/* TAL1: case of jmp, slight modification: 
   added the two extra cases 'typeOfWval-VarL : case TypeOfVarL' and 'LookupVarL : case typeOfWval-VarL'
   to derive a lookup formula from typing a label, which Find-type-in-env-byLookupH works with. 
   two cases because typeOfV goes through typeOfWval because releasing the lookup formula. */


Beginsjmp: apply Step. 
Prem0: case Step(keep).  
TypeOfVarL: apply Typing0. 
TypeOfWval-VarL : case TypeOfVarL. 
LookupVarL : case TypeOfWval-VarL.
TypeOfVarcode: apply Find-type-in-env-byLookupH to Prem0 TypeOfH LookupVarL.  
case TypeOfVarcode(keep).  
apply flag_subtyping_is_equality_on_codeT to LookupVarL1. 
witness EnvH.  
witness EnvR.  
split.  
/* TAL2: backchain Type-state-envs-weakening-R instead of backchain Type-state-envs-weakening-H. */
backchain Type-state-envs-weakening-R.  
search.
search.

/* TAL1: case of bnz, slight modification: 
   added the two extra cases 'TypeOfWval-VarL : case TypeOfVarL' and 'LookupVarL : case TypeOfWval-VarL'
   as above for jmp. */

 Beginsbnz: apply Step. 
 Prem0: case Step(keep).  
 TypeOfVarZs: apply Typing0. 
 TypeOfVarL: apply Typing1. 
 TypeOfVarE2: apply Typing2. 
 TypeOfVarnum: apply Find-type-in-env-byLookupR to Prem0 TypeOfR TypeOfVarZs with EnvH = EnvH.  
 case TypeOfVarnum(keep).  
typeOfWval-VarL : case TypeOfVarL. 
LookupVarL : case typeOfWval-VarL.
 TypeOfVarcode: apply Find-type-in-env-byLookupH to Prem1 TypeOfH LookupVarL.  
 case TypeOfVarcode(keep).  
 apply flag_subtyping_is_equality_on_codeT to LookupVarL1. 
 witness EnvH.  
 witness EnvR.  
 split.  
 backchain Type-state-envs-weakening-R.  
 search.  
 search.  

 TypeOfVarZs: apply Typing0. 
 TypeOfVarL: apply Typing1. 
 TypeOfVarE: apply Typing2. 
 TypeOfVarnum: apply Find-type-in-env-byLookupR to Prem0 TypeOfR TypeOfVarZs with EnvH = EnvH.  
 case TypeOfVarnum(keep).  
 witness EnvH.  
 witness EnvR.  
 split.  
/* TAL2: backchain Type-state-envs-weakening-R instead of backchain Type-state-envs-weakening-H. */
 backchain Type-state-envs-weakening-R.  
 search.  
 search.  





