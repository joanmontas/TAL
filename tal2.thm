skip.


/* TAL2: moved lookup_when_inequal_labels-EnvR here because other lemmas need it earlier */ 
Theorem lookup_when_inequal_labels-EnvR :
  forall l1 l2 map map' e1 e2,
    (l2 = l1 -> false) ->
    {updateEnvR map l1 e1 map'}    ->
    {lookupEnvR map l2 e2} ->
    {lookupEnvR map' l2 e2}.
induction on 2.
  intros Lanld STupdate STlookup.
  STupdate : case STupdate.
      case STlookup.
          apply inequality_contradiction-R to Lanld.
