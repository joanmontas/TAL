%% slight modification: typeOfH
Theorem typeOfH-weakening-H :
  forall gamma EnvH EnvR e t EnvH',
    {typeOfH gamma EnvH EnvR e t} ->
    {subsetEnvH EnvH EnvH'} ->
    {typeOfH gamma EnvH' EnvR e t}.
intros Main Subset. case Main.
  apply typeOfW-weakening-H to H1 Subset.
  apply typeOfW-weakening-H to H2 Subset.
  search.
apply Type-state-envs-weakening-H to H1 Subset.
  search.
/* ------------------------------------------------------------------------------- */
%% modification: typeOfHNEW and extra
Theorem TypeOf-weakening-H:  
    forall envH envR map E T l,  
      typeOfHNEW envH envR map ->  
      {typeOfH nilEnvT envH envR E T} ->  
      typeOfHNEW (consEnvH l T envH)  envR (consMapH l E map).
intros TypeOfH TypeOfE.
TypeOfHExpanded: case TypeOfH.
unfold.
intros LookupEnv.
LookupEnv: case LookupEnv.
  witness E. split.
  search.
  SubsetEnvH: assert {subsetEnvH envH (consEnvH l1 t envH)}.
  apply typeOfH-weakening-H to TypeOfE SubsetEnvH.
  search.
  TypeOfHFormulae0: apply TypeOfHExpanded to LookupEnv.
  witness e. 
  split.
  search. 
  SubsetEnvH: assert {subsetEnvH envH (consEnvH l T envH)}.
  apply typeOfH-weakening-H to TypeOfHFormulae1 SubsetEnvH. 
  search.
