%% slight modification: typeOfHNEW
Theorem TypeOf-addH : 
  forall map E map' L T env envR,  
  {addMapH map E map' L} -> 
  typeOfHNEW (consEnvH L T env) envR (consMapH L E map) ->
  typeOfHNEW (consEnvH L T env) envR map'.
induction on 1. intros Main Lookup.
  Subset: case Main.
  search.
