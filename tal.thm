%% slight modification: accounts for new Define typeOfHNEW
Theorem Find-type-in-envR :
    forall EnvH EnvR map L e T,
    {lookupMapR map L e} ->
    typeOfR EnvH EnvR map ->
    {lookupEnvR EnvR L T} ->
    {typeOfV (nilEnvT) EnvH EnvR e T}.
intros Lookup typeOfHNEW LookupEnv.
	case typeOfHNEW(keep).
	apply H1 to LookupEnv.
	apply Uniqueness-of-lookupMap-R to Lookup H2.
	search.
