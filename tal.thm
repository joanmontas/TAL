% modification: removed necesary cases such as beginsone, beginzero
Theorem Type-preservation:
  forall EnvH, forall EnvR, forall e, forall typ, forall H, forall R, forall e', forall H', forall R',
  {typeOf (nilEnvT) EnvH EnvR e typ} ->
  typeOfHNEW EnvH EnvR H -> 
  typeOfR EnvH EnvR R ->
  {step e H R e' H' R'} -> 
  exists EnvH', exists EnvR', 
  {subsetEnvH EnvH EnvH'} /\ {typeOf (nilEnvT) EnvH' EnvR' e' typ} /\ 
  typeOfHNEW EnvH' EnvR' H' /\ typeOfR EnvH' EnvR' R'.
IH0 : induction on 1. %% Perform Induction on the 1th premise
intros Main typeOfHNEW TypeOfR Step.
Typing0: case Main.
/* ################################### halt ############################################# */
%% match
 Beginshalt: apply Step.
 Prem0: case Step(keep).
/* ################################### add ############################################# */
%% match
Beginadd: apply Step.
Prem0: case Step(keep).  
TypingInsertedZd: apply Typing0. 
TypingInsertedZs: apply Typing1. 
TypingInsertedV1: apply Typing2. 
TypingInsertedE: apply Typing3. 
LookupInsertedZs: apply TypingInsertedZs. 
TypingInsertedV2: apply Find-type-in-envR to Prem0 TypeOfR LookupInsertedZs with EnvH = EnvH.  
 
TypingInsertedV3: apply Find-type-user-defined-addition to Prem1 TypingInsertedV1 TypingInsertedV2.
Tmp: apply Irrelevance-Env-for-ValueTyping-R to TypingInsertedV3 Prem3 with EnvR' = EnvR'.
TypeOfR': apply TypeOf-updateR to TypeOfR Typing3 Tmp Prem2.
witness EnvH.  
witness EnvR'.  
split.  
search.  
backchain Type-state-envs-weakening-H.  
backchain TypeOf-irrelevanceOfEnv-H.  
search.
/* ################################### mult ############################################# */
%% match
Beginsmult: apply Step. 
Prem0: case Step(keep).  
TypingInsertedZd: apply Typing0. 
TypingInsertedZs: apply Typing1. 
TypingInsertedV1: apply Typing2. 
TypingInsertedE: apply Typing3. 
LookupInsertedZs: apply TypingInsertedZs. 
TypingInsertedV2: apply Find-type-in-envR to Prem0 TypeOfR LookupInsertedZs with EnvH = EnvH.  
 
TypingInsertedV3: apply Find-type-user-defined-multiplication to Prem1 TypingInsertedV1 TypingInsertedV2.
Tmp: apply Irrelevance-Env-for-ValueTyping-R to TypingInsertedV3 Prem3 with EnvR' = EnvR'.
TypeOfR': apply TypeOf-updateR to TypeOfR Typing3 Tmp Prem2.
witness EnvH.  
witness EnvR'.  
split.  
search.  
backchain Type-state-envs-weakening-H.  
backchain TypeOf-irrelevanceOfEnv-H.  
search.
/* ################################### load ############################################# */
Beginload: apply Step.
Prem0: case Step(keep).
apply Find-type-in-envR to Prem0 TypeOfR Typing1.
case H1.
case H2.
apply Find-type-in-envH to Prem1 typeOfHNEW H3.
case H4.
case Prem2.
case Typing2.
assert {typeOfV nilEnvT EnvH EnvR V' T}.
apply Irrelevance-Env-for-ValueTyping-R to H7 Prem4 with EnvR' = EnvR'.
apply TypeOf-updateR to TypeOfR Typing3 H8 Prem3.
witness EnvH.
witness EnvR'.
split.
search.
search.
backchain TypeOf-irrelevanceOfEnv-H.
search.
case Typing2.
assert {typeOfV nilEnvT EnvH EnvR V' T}.
apply Irrelevance-Env-for-ValueTyping-R to H7 Prem4 with EnvR' = EnvR'.
apply TypeOf-updateR to TypeOfR Typing3 H8 Prem3.
witness EnvH.
witness EnvR'.
split.
search.
search.
backchain TypeOf-irrelevanceOfEnv-H.
search.
/* ################################### malloc ############################################# */
Beginmalloc: apply Step.
Prem0: case Step(keep).
witness (consEnvH LNewH (arrayT T1 zero T2 zero) EnvH).
witness EnvR'.
split.
search.
SubFact: assert {subsetEnvH EnvH (consEnvH LNewH (arrayT T1 zero T2 zero) EnvH)}.
apply Type-state-envs-weakening-H to Typing2 SubFact.
search.
HNEW_R': apply TypeOf-irrelevanceOfEnv-H to typeOfHNEW with EnvR' = EnvR'.
ArrTyp: assert {typeOfH nilEnvT EnvH EnvR' (array (junk T1) (junk T2)) (arrayT T1 zero T2 zero)}.
HNEW_Ext: apply TypeOf-weakening-H to HNEW_R' ArrTyp with l = LNewH.
apply TypeOf-addH to Prem0 HNEW_Ext.
search.
case Prem0.
Reg_Ext: apply Irrelevance-TypeOf-with-ExtensionsOfEnv-R to TypeOfR with L = L, T = (arrayT T1 zero T2 zero).
PtrTyp: assert {typeOfV nilEnvT (consEnvH (succLabelH L) (arrayT T1 zero T2 zero) EnvH) EnvR' (labelH (succLabelH L)) (refH (arrayT T1 
zero T2 zero))}.
apply TypeOf-updateR to Reg_Ext Typing1 PtrTyp Prem1.
search.
/* ################################### move ############################################# */
%% slight modificaiton
Beginsmove: apply Step. 
Prem0: case Step(keep).  
TypingInsertedZd: apply Typing0. 
TypingInsertedV: apply Typing1. 
TypingInsertedE: apply Typing2. 
Tmp: apply Irrelevance-Env-for-ValueTyping-R to TypingInsertedV _ with EnvR' = EnvR'.
TypeOfR': apply TypeOf-updateR to TypeOfR TypingInsertedE Tmp Prem0.
witness EnvH.
witness EnvR'.
split.
search.
backchain Type-state-envs-weakening-H.
backchain TypeOf-irrelevanceOfEnv-H.
search.
/* ################################### store ############################################# */
Beginstore: apply Step.
Prem0: case Step(keep).
apply Find-type-in-envR to Prem0 TypeOfR Typing0.
case H1.
case H2.
apply Find-type-in-envR to Prem1 TypeOfR Typing2.
case Prem2.
case Typing1.
case Typing3.
case H4.
case H5.
apply Find-type-in-envR to Prem1 TypeOfR Typing2.
case H5.
case H6.
/* ################################### jmp ############################################# */
% slight modification: added extra case on LookupInsertedL
Beginsjmp: apply Step. 
Prem0: case Step(keep).  
TypingInsertedL: apply Typing0. 
LookupInsertedL: case TypingInsertedL(keep).  
LookupInsertedLCase: case LookupInsertedL.
TypingInsertedcode: apply Find-type-in-envH to Prem0 typeOfHNEW LookupInsertedLCase with EnvR = EnvR.  
case TypingInsertedcode(keep).  
witness EnvH.  
witness EnvR.  
split.  
search.  
backchain Type-state-envs-weakening-H.  
backchain TypeOf-irrelevanceOfEnv-H.  
search.
/* ################################### bnz ############################################# */
% slight modification: added extra case on LookupInsertedL
Beginsbnz: apply Step. 
Prem0: case Step(keep).  
TypingInsertedZs: apply Typing0. 
TypingInsertedL: apply Typing1. 
TypingInsertedE2: apply Typing2. 
LookupInsertedZs: apply TypingInsertedZs. 
TypingInsertedzero: apply Find-type-in-envR to Prem0 TypeOfR LookupInsertedZs with EnvH = EnvH.  
case TypingInsertedzero(keep).  
LookupInsertedL: case TypingInsertedL(keep).  
LookupInsertedLCase: case LookupInsertedL.
TypingInsertedcode: apply Find-type-in-envH to Prem1 typeOfHNEW LookupInsertedLCase with EnvR = EnvR.  
case TypingInsertedcode(keep).  
witness EnvH.  
witness EnvR.  
split.  
search.  
backchain Type-state-envs-weakening-H.  
backchain TypeOf-irrelevanceOfEnv-H.  
search.  
TypingInsertedZs: apply Typing0. 
TypingInsertedL: apply Typing1. 
TypingInsertedE: apply Typing2. 
LookupInsertedZs: apply TypingInsertedZs. 
TypingInsertedone: apply Find-type-in-envR to Prem0 TypeOfR LookupInsertedZs with EnvH = EnvH.  
case TypingInsertedone(keep).  
witness EnvH.  
witness EnvR.  
split.  
search.  
backchain Type-state-envs-weakening-H.  
backchain TypeOf-irrelevanceOfEnv-H.  
search.
