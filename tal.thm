Theorem Type-preservation:
  forall EnvH, forall EnvR, forall e, forall typ, forall H, forall R, forall e', forall H', forall R',
  {typeOf (nilEnvT) EnvH EnvR e typ} ->
  typeOfHNEW EnvH EnvR H -> 
  typeOfR EnvH EnvR R ->
  {step e H R e' H' R'} -> 
  exists EnvH', exists EnvR', 
  {subsetEnvH EnvH EnvH'} /\ {typeOf (nilEnvT) EnvH' EnvR' e' typ} /\ 
  typeOfHNEW EnvH' EnvR' H' /\ typeOfR EnvH' EnvR' R'. 
IH0 : induction on 1.
intros Main typeOfHNEW TypeOfR Step.
Typing0: case Main.

Beginshalt: apply Step.
Prem0: case Step(keep).

Beginadd: apply Step.
Prem0: case Step(keep).
apply Find-type-in-envR to Prem0 TypeOfR Typing1.
apply Find-type-user-defined-addition to Prem1 Typing2 H1.
apply Irrelevance-Env-for-ValueTyping-R to H2 Prem3 with EnvR' = EnvR'.
apply TypeOf-updateR to TypeOfR Typing3 H3 Prem2.
witness EnvH.
witness EnvR'.
split.
search.
search.
backchain TypeOf-irrelevanceOfEnv-H.
search.

Beginmult: apply Step.
Prem0: case Step(keep).
apply Find-type-in-envR to Prem0 TypeOfR Typing1.
apply Find-type-user-defined-multiplication to Prem1 Typing2 H1.
apply Irrelevance-Env-for-ValueTyping-R to H2 Prem3 with EnvR' = EnvR'.
apply TypeOf-updateR to TypeOfR Typing3 H3 Prem2.
witness EnvH.
witness EnvR'.
split.
search.
search.
backchain TypeOf-irrelevanceOfEnv-H.
search.

Beginload: apply Step.
Prem0: case Step(keep).
apply Find-type-in-envR to Prem0 TypeOfR Typing1.
case H1.
case H2.
apply Find-type-in-envH to Prem1 typeOfHNEW H3.
case H4.
case Prem2.
case Typing2.
assert {typeOfV nilEnvT EnvH EnvR V' T}.
apply Irrelevance-Env-for-ValueTyping-R to H7 Prem4 with EnvR' = EnvR'.
apply TypeOf-updateR to TypeOfR Typing3 H8 Prem3.
witness EnvH.
witness EnvR'.
split.
search.
search.
backchain TypeOf-irrelevanceOfEnv-H.
search.
case Typing2.
assert {typeOfV nilEnvT EnvH EnvR V' T}.
apply Irrelevance-Env-for-ValueTyping-R to H7 Prem4 with EnvR' = EnvR'.
apply TypeOf-updateR to TypeOfR Typing3 H8 Prem3.
witness EnvH.
witness EnvR'.
split.
search.
search.
backchain TypeOf-irrelevanceOfEnv-H.
search.

Beginmalloc: apply Step.
Prem0: case Step(keep).
witness (consEnvH LNewH (arrayT T1 zero T2 zero) EnvH).
witness EnvR'.
split.
search.
SubFact: assert {subsetEnvH EnvH (consEnvH LNewH (arrayT T1 zero T2 zero) EnvH)}.
apply Type-state-envs-weakening-H to Typing2 SubFact.
search.
HNEW_R': apply TypeOf-irrelevanceOfEnv-H to typeOfHNEW with EnvR' = EnvR'.
ArrTyp: assert {typeOfH nilEnvT EnvH EnvR' (array (junk T1) (junk T2)) (arrayT T1 zero T2 zero)}.
search.
HNEW_Ext: apply TypeOf-weakening-H to HNEW_R' ArrTyp with l = LNewH.
apply TypeOf-addH to Prem0 HNEW_Ext.
search.
case Prem0.
Reg_Ext: apply Irrelevance-TypeOf-with-ExtensionsOfEnv-R to TypeOfR with L = L, T = (arrayT T1 zero T2 zero).
PtrTyp: assert {typeOfV nilEnvT (consEnvH (succLabelH L) (arrayT T1 zero T2 zero) EnvH) EnvR' (labelH (succLabelH L)) (refH (arrayT T1 zero T2 zero))}.
search.
apply TypeOf-updateR to Reg_Ext Typing1 PtrTyp Prem1.
search.

case Step.
apply Irrelevance-Env-for-ValueTyping-R to Typing1 H2 with EnvR' = EnvR'.
apply TypeOf-updateR to TypeOfR Typing2 H3 H1.
exists EnvH.
exists EnvR'.
split.
search.
search.
backchain TypeOf-irrelevanceOfEnv-H.
search.

Beginstore: apply Step.
Prem0: case Step(keep).
apply Find-type-in-envR to Prem0 TypeOfR Typing0.
case H1.
case H2.
apply Find-type-in-envR to Prem1 TypeOfR Typing2.
case Prem2.
case H4.
case H5.
case H6.
case H5.
case H6.

Beginjmp: apply Step.
case Typing0.
Prem0: case Step.
Prem1: case H1.
apply Find-type-in-envH to Prem0 typeOfHNEW Prem1.
case H2.
witness EnvH.
witness EnvR.
split.
search.
search.
search.
search.

Beginbnz: apply Step.
case Typing1.
case H1.
case Step.
case Step.
witness EnvH.
witness EnvR.
split.
search.
apply Find-type-in-envH to H4 typeOfHNEW H2.
case H5.
search.
search.
search.
witness EnvH.
witness EnvR.
split.
search.
search.
search.
search.