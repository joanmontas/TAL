%% match
Theorem Lookup-store-weakening-H:
  forall env, forall env', forall l, forall t,
    {subsetEnvH env env'} ->
    {lookupEnvH env l t} ->
    {lookupEnvH env' l t}.
IH0 : induction on 1. intros Main Lookup. Subset: case Main.
 search.
 apply IH0 to Subset Lookup.
 search.

/* ------------------------------------------------------------------------------- */

Theorem typeOfW-weakening-H :
  forall gamma EnvH EnvR e t fl EnvH',
    {typeOfW gamma EnvH EnvR e t fl} ->
    {subsetEnvH EnvH EnvH'} ->
    {typeOfW gamma EnvH' EnvR e t fl}.
intros Main Subset.
  case Main.
  search.
  search.
  search.
  apply Lookup-store-weakening-H to Subset H1. 
  search.

/* ------------------------------------------------------------------------------- */

Theorem typeOfV-weakening-H :
  forall gamma EnvH EnvR e t EnvH',
    {typeOfV gamma EnvH EnvR e t} ->
    {subsetEnvH EnvH EnvH'} ->
    {typeOfV gamma EnvH' EnvR e t}.
intros Main Subset.
  case Main.
  apply typeOfW-weakening-H to H1 Subset.
  search.

