%% slight modification: backchain typeOfV-weakening-H. instead of backchain Type-state-envs-weakening-H.
 Theorem Irrelevance-TypeOf-with-ExtensionsOfEnv-R: 
 	forall EnvH EnvR L T R,
 	typeOfR EnvH EnvR R ->
 	typeOfR (consEnvH (succLabelH L) T EnvH) EnvR R.
	intros TypeOfR.
  TypeOfRExpanded: case TypeOfR. 
  unfold. intros LookupFromGoal.
  FromTypeOfR : apply TypeOfRExpanded to LookupFromGoal. 
  exists e. split. search. 
  backchain typeOfV-weakening-H.
/* ------------------------------------------------------------------------------- */
%% slight modification: typeOfHNEW
Theorem TypeOf-irrelevanceOfEnv-H: 
  forall EnvH, forall EnvR, forall map, forall EnvR',
  typeOfHNEW EnvH EnvR map ->
  typeOfHNEW EnvH EnvR' map.
intros Main.  
TypeOfExpanded: case Main(keep).  
unfold.  
intros Main1.  
apply TypeOfExpanded to Main1.  
apply Store-stores-values-H to H1.  
witness e.  
case H3(keep).
case H2(keep).
case H2(keep).
case H2(keep).
case H2(keep).
case H2(keep).
