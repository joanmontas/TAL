Theorem TypeOf-irrelevanceOfEnv-H: 
  forall EnvH, forall EnvR, forall map, forall EnvR',
  typeOfHNEW EnvH EnvR map ->
  typeOfHNEW EnvH EnvR' map.
intros Main.  
 TypeOfExpanded: case Main(keep).  
 unfold.  
 intros Main1.  
 apply TypeOfExpanded to Main1.  
 apply Store-stores-values-H to H1.  
 witness e.  
 case H3(keep).
 case H2.
 case H2.
 case H2.
 case H2.
 case H2.

