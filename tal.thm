%% slight modification: removed unnecesary case analysis on typeof
Theorem Irrelevance-Env-for-ValueTyping-R: 
  forall EnvH, forall EnvR, forall v, forall t, forall EnvR',
  {typeOfV (nilEnvT) EnvH EnvR v t} -> 
  {value v} -> 
  {typeOfV (nilEnvT) EnvH EnvR' v t}.
intros TypeOf ValueHyp.  
 case TypeOf(keep).
case H1.
search.
search.
search.
search.
/* ------------------------------------------------------------------------------- */

Define typeOfHNEW: envH -> envR -> mapH -> prop by
typeOfHNEW EnvH EnvR MapH := forall l, forall t, 
{lookupEnvH EnvH l t} -> 
exists e, {lookupMapH MapH l e} /\ {typeOfH (nilEnvT) EnvH EnvR e t}.

Define typeOfR: envH -> envR -> mapR -> prop by
typeOfR EnvH EnvR MapR := forall l, forall t, 
{lookupEnvR EnvR l t} -> 
exists e, {lookupMapR MapR l e} /\ {typeOfV (nilEnvT) EnvH EnvR e t}.

